# Line-ending policy.
#
# Store every text file with LF in the repository and check it out with LF on
# every platform (including Windows), overriding each machine's core.autocrlf.
# Without this, Windows rewrites the whole tree to CRLF on checkout, so `git
# status` shows every file modified and the mixed-line-ending pre-commit hook
# (configured with --fix=lf) keeps fighting the checkout. `text=auto` lets Git
# auto-detect which files are text.
* text=auto eol=lf

# The Gradle wrapper Unix script must stay LF and executable.
gradlew text eol=lf

# Windows batch scripts only work reliably with CRLF.
*.bat text eol=crlf

# gradlew.bat is vendored and is regenerated by Dependabot's Gradle-wrapper bumps
# with a CRLF blob. Under `text` Git renormalizes it against the LF-in-repo policy
# above and then reports it as permanently modified, which blocks branch switches
# locally and breaks workflows that do a base checkout. `-text` freezes it: Git
# stores and checks out the exact bytes, never converting or diffing line
# endings. The committed blob must therefore already be CRLF - which is what
# cmd.exe expects and what `.editorconfig`'s [*.bat] end_of_line = crlf assumes.
gradlew.bat -text

# Binary assets Git must never convert or diff.
*.jar binary
*.keystore binary
*.jks binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary

# Recorded workout fixtures used by the export golden-file tests must stay
# byte-exact; FIT is binary, and GPX/TCX goldens must not be re-indented or
# line-ending-normalized by any tool.
*.fit binary
*.gpx text eol=lf
*.tcx text eol=lf
