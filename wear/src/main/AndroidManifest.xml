<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Restricts installation to watches, and tells Google Play this APK is the
         Wear OS form factor of the shared applicationId. -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <!-- Recording. BODY_SENSORS covers the optical heart-rate sensor, and
         ACTIVITY_RECOGNITION is what Health Services needs for step-derived
         cadence. Location is fine-grained because a workout track from coarse
         location is worthless. Android requires the coarse permission to be
         declared alongside the fine one: from API 31 the user can grant only
         approximate location, and without both declared that choice would leave
         the app with nothing at all. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Without this the watch stops handing over positions the moment the app
         is not on screen - which on a ride is almost immediately, and is
         precisely when it is needed. The symptom is not an error: fixes simply
         stop arriving, so the distance freezes while the timer runs on and the
         satellite indicator stays green, because availability is still reported.
         See RecordingService for the other half of the requirement. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- The same rule for the heart rate: from API 33 the watch stops reading
         its own sensor once the app is out of sight unless this is held. -->
    <uses-permission
        android:name="android.permission.BODY_SENSORS_BACKGROUND"
        android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- Wear OS 6 supersedes BODY_SENSORS with the granular health permissions;
         both are declared so one build serves watches on either side of it. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!-- External sensors. BLUETOOTH_SCAN carries neverForLocation because the
         app scans for fitness sensors, not to infer where the rider is. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- minSdk is 30, and the granular permissions above only exist from 31. On
         Wear OS 3 the legacy pair is what connectGatt actually checks, so without
         these every external sensor is dead on those watches. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- The recording outlives the screen, so it runs in a foreground service.
         The health type is the one Wear OS expects for an exercise. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- A foreground service only keeps access to location if it says that is
         what it is for. Declaring health alone kept the process alive and let
         the positions stop anyway. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Uploading finished workouts and polling the timing server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Auto-backup is off: the app will hold OAuth tokens for Strava / Garmin
         Connect plus raw location and heart-rate tracks, and Android's automatic
         backup would copy all of it to the user's Google Drive outside our
         control. Anything that should survive a reinstall gets an explicit,
         reviewed export path instead. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- The watch app records and stores a workout on its own; a paired phone
             is only needed to forward it to Strava / Garmin Connect. Declaring it
             standalone keeps it installable on watches paired with an iPhone and
             is required for the Wear OS Play Store listing. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The health type is what Wear OS expects for an exercise; anything
             else is refused on API 34+. -->
        <!-- Receives settings even when the app is not running: a change that
             only lands while the rider has the app open is a coincidence, not a
             setting. -->
        <service
            android:name=".sync.SettingsListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/settings" />
                <!-- Credentials travel on their own path, so the filter has to
                     name it too. Without this line the phone publishes tokens
                     that are never delivered, and every upload fails to log in
                     with nothing anywhere saying why. -->
                <data android:scheme="wear" android:host="*" android:pathPrefix="/credentials" />
                <!-- And segments, one item each. Without this line the phone
                     publishes the rider's starred climbs and the watch is never
                     woken to store them. -->
                <data android:scheme="wear" android:host="*" android:pathPrefix="/segment/" />
            </intent-filter>
        </service>

        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="health|location" />
    </application>

</manifest>
