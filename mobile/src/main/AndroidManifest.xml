<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- This manifest deliberately does NOT declare
         <uses-feature android:name="android.hardware.type.watch">. Android Lint
         rejects android:required="false" on it outright
         (InvalidWearFeatureAttribute: "A single APK for Wear and non-Wear devices
         is not supported"), and required="true" would restrict the companion to
         watches. Simply omitting it is how a handheld APK declares itself: Play
         routes watches to the wear APK, which declares the feature as required. -->

    <!-- The Strava authorization is a loopback redirect plus a token exchange,
         both of which are network. Without this the socket cannot even be bound,
         and connecting fails with an error that says nothing about a permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The sign-in holds a loopback port open while the rider is away in a
         browser, which means this process must not be frozen while they are. A
         frozen process has its inbound traffic dropped rather than refused, so
         the redirect carrying the authorization code times out against the
         phone's own address - see SignInService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- See the comment in the wear manifest: no automatic Google Drive backup of
         third-party OAuth tokens or workout data. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Runs for the length of one sign-in and stops itself. -->
        <service
            android:name=".connect.SignInService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The one path that runs watch-to-phone. Without this declaration the
             watch publishes its workouts and nothing on the phone is ever woken
             to receive them, which is precisely how the history screen came to
             be fully written and permanently empty. -->
        <service
            android:name=".sync.WorkoutListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/workouts" />
            </intent-filter>
        </service>
    </application>

</manifest>
